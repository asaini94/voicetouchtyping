---
import "../styles/global.css";
import TypingTrainer from "../components/TypingTrainer.astro";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>VoiceTouch — Voice-Prompted Typing Trainer</title>
    <meta
      name="description"
      content="Train your touch typing skills with voice-prompted practice. Listen, type, and improve your speed and accuracy."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <TypingTrainer />
  </body>
</html>
